# Optional compose build-time vars for the client image (repo root).
# Copy: cp .env.production.example .env  (only on VPS if you need custom Vite vars)
# docker compose reads these when building the client image.

VITE_API_BASE_URL=/api
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_CLIENT_ID=

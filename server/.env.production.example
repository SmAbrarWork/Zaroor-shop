# Copy on the VPS:  cp server/.env.production.example server/.env
# Then edit every placeholder. Never commit server/.env.

NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@cluster.example.mongodb.net/zeroor_shop?retryWrites=true&w=majority

# Public site URL(s) for CORS (comma-separated: apex + www + https)
CLIENT_URL=https://zaroor.shop,https://www.zaroor.shop

JWT_SECRET=generate_a_long_random_string_at_least_32_chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://zaroor.shop/api/auth/google/callback

META_PIXEL_ID=
META_CONVERSIONS_TOKEN=

GA4_MEASUREMENT_ID=
GA4_API_SECRET=

STRIPE_SECRET_KEY=
JAZZCASH_MERCHANT_ID=
EASYPAISA_STORE_ID=
